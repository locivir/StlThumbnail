<Window x:Class="StlThumbConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STL Thumbnail Configuration" Width="860" Height="560"
        MinWidth="760" MinHeight="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- controls -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <GroupBox Header="Camera angle" Padding="8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Rotation (yaw)" Width="110"/>
                            <TextBlock Text="{Binding ElementName=Yaw, Path=Value, StringFormat={}{0:0}°}" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                            <Slider x:Name="Yaw" Minimum="-180" Maximum="180" Value="30" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSetting"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Tilt (pitch)" Width="110"/>
                            <TextBlock Text="{Binding ElementName=Pitch, Path=Value, StringFormat={}{0:0}°}" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                            <Slider x:Name="Pitch" Minimum="-90" Maximum="90" Value="25" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSetting"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Colors" Padding="8" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Model color" Width="110" VerticalAlignment="Center"/>
                            <Rectangle x:Name="ModelSwatch" Width="40" Height="20" Stroke="Gray" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                            <Button Content="Choose…" Click="PickModelColor" Width="90" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Background" Width="110" VerticalAlignment="Center"/>
                            <Rectangle x:Name="BgSwatch" Width="40" Height="20" Stroke="Gray" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                            <Button Content="Choose…" Click="PickBgColor" Width="90" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <CheckBox x:Name="BgTransparent" Content="Transparent background" IsChecked="True" Margin="0,6,0,0" Checked="OnSetting" Unchecked="OnSetting"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Lighting" Padding="8" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Ambient" Width="110"/>
                            <TextBlock Text="{Binding ElementName=Ambient, Path=Value, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                            <Slider x:Name="Ambient" Minimum="0" Maximum="100" Value="30" ValueChanged="OnSetting"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Key light" Width="110"/>
                            <TextBlock Text="{Binding ElementName=Diffuse, Path=Value, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                            <Slider x:Name="Diffuse" Minimum="0" Maximum="100" Value="80" ValueChanged="OnSetting"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Light direction" Width="110"/>
                            <TextBlock Text="{Binding ElementName=LightYaw, Path=Value, StringFormat={}{0:0}°}" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                            <Slider x:Name="LightYaw" Minimum="-180" Maximum="180" Value="-40" ValueChanged="OnSetting"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Light height" Width="110"/>
                            <TextBlock Text="{Binding ElementName=LightPitch, Path=Value, StringFormat={}{0:0}°}" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                            <Slider x:Name="LightPitch" Minimum="-90" Maximum="90" Value="45" ValueChanged="OnSetting"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Save &amp; Apply" Click="SaveApply" Padding="14,6" FontWeight="Bold"/>
                    <Button Content="Reset defaults" Click="ResetDefaults" Padding="14,6" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="Status" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- preview -->
        <GroupBox Grid.Column="1" Header="Preview" Padding="8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Open STL…" Click="OpenStl" Padding="10,3" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="StlName" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </DockPanel>
                <Border Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" >
                    <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
